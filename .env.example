# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin Allowlist (comma-separated emails)
ADMIN_EMAILS=admin@example.com,editor@example.com

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry error monitoring (Issue #139). All optional — with no DSN the
# SDK never initializes and nothing is sent anywhere (local dev/CI).
# The DSN is public runtime configuration (embedded in the client
# bundle by design), NOT a secret. Secrets are the build-time values.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional environment override; defaults to VERCEL_ENV then NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build-time source-map upload (Vercel build env only, never committed):
# SENTRY_ORG=your_sentry_org_slug          # not secret, but not public config either
# SENTRY_PROJECT=your_sentry_project_slug  # not secret
# SENTRY_AUTH_TOKEN=sntryu_xxx             # SECRET — Sentry org auth token
# Optional release override; the Sentry build plugin otherwise derives
# the release from the VCS commit SHA automatically.
# SENTRY_RELEASE=your_release_name

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.sabafpca.com

# Maintenance mode (server-side only — do NOT prefix with NEXT_PUBLIC_).
# Set to "true" in the Vercel Production environment to gate all public
# routes behind /under-construction. Leave unset/false in Preview,
# development, and CI so the full site stays reachable.
# SITE_MAINTENANCE_MODE=true

# NEXT_PUBLIC_USE_FIREBASE_EMULATOR is intentionally absent: it is set
# only by the Playwright E2E harness. Never set it in a real deployment —
# it connects the client SDK to emulators instead of production.
