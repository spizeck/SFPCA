# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin bootstrap list (comma-separated emails, server-side only).
# NOT the authorization authority — Postgres `admin_users` is. This list
# exists solely so a legitimate administrator can bootstrap the first
# admin_users row (and as an emergency break-glass) after a deploy or
# data loss. See RUNBOOK §22 provisioning.
ADMIN_EMAILS=admin@example.com,editor@example.com

# Analytics via Google Tag Manager (#116). PUBLIC runtime config — embedded
# in the client bundle by design, not a secret. GTM is only injected after
# the visitor grants analytics consent in the Klaro banner; GA4 itself is
# configured inside the GTM container, not here. The old NEXT_PUBLIC_GA_ID
# direct-loading variable was removed — set it in GTM instead.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Sentry error monitoring (#139/#140). All optional — with no DSN the
# SDK never initializes and nothing is sent anywhere (local dev/CI).
# See RUNBOOK §15 for the full setup/verification procedure.
#
# PUBLIC RUNTIME CONFIG — embedded in the client bundle by design, NOT
# a secret. Recommended Vercel scoping: Production + Preview (the
# environment tag differentiates events). Production-only is fine if
# you never want preview events.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Optional environment override (public). Defaults to VERCEL_ENV
# (production|preview|development on Vercel) then NODE_ENV — only set
# if the auto value is wrong.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# BUILD-TIME source-map upload — set in Vercel env (build step), never
# NEXT_PUBLIC_*, never committed. Scope: Production (+ Preview if you
# want preview events symbolicated). Without these the build still
# succeeds — it just skips the upload and stack traces stay minified.
# SENTRY_ORG=your_sentry_org_slug          # not secret
# SENTRY_PROJECT=your_sentry_project_slug  # not secret
# SENTRY_AUTH_TOKEN=sntryu_xxx             # SECRET — org auth token
#
# Optional release override (build-time). The build plugin derives the
# release automatically — SENTRY_RELEASE env var, else `git rev-parse
# HEAD` — and injects the SAME value into the SDK, so events and
# source maps share a release. Only set this to override.
# SENTRY_RELEASE=your_release_name

# Postgres registry (#165/#183) — server-side only, never NEXT_PUBLIC_*.
# REQUIRED at runtime in every deployed environment: Postgres is the
# sole authority for animals, registrations, and admin authorization —
# public reads, admin mutations, and login all need it.
# The Vercel–Neon integration provides both endpoints per environment
# (scoped to Production and Preview only — Development gets none, so
# local dev stays on PGlite):
#   DATABASE_URL           — pooled endpoint (-pooler host) for app queries
#   DATABASE_URL_UNPOOLED  — unpooled endpoint for schema/data migrations
# Local dev does NOT need them unless you run the dev server against a
# real database: unit/registry tests run on PGlite (in-process Postgres
# WASM) and E2E uses its own PGlite wire server (tests/e2e/global-setup).
# DATABASE_URL=postgresql://...-pooler.../sfpca?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://.../sfpca?sslmode=require
#
# Per-instance query pool size (default 3). Only set to 1 when pointing
# DATABASE_URL at a PGlite socket server (E2E does this automatically) —
# its per-message query forwarding requires a serialized connection.
# DATABASE_POOL_MAX=3
# Guards the /api/cron/* routes (vercel.json schedules them).
# Set a strong random value in BOTH Production and Preview; Vercel cron
# sends it as the Authorization bearer. Unset → routes deny everything.
# CRON_SECRET=generate-a-long-random-string
#
# Reminder email delivery (#172) via Resend — server-side only.
# Without RESEND_API_KEY + EMAIL_FROM, the reminder cron refuses live
# runs (503) rather than queueing mail that cannot send; dry-run works
# regardless. The sender domain must be verified in Resend.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=SFPCA <reminders@yourdomain.com>
#
# Signing secret for /api/webhooks/resend (Resend dashboard → Webhooks).
# Without it the webhook route refuses all requests (503). See RUNBOOK §22.
# RESEND_WEBHOOK_SECRET=whsec_xxx
#
# Required ONLY by scripts/migrate-firestore.ts when writing (--execute);
# must equal the --project flag. A deliberate second confirmation so a
# migration can never bulk-write an unexpected target.
# MIGRATION_CONFIRM_PROJECT=your_project_id
#
# Operator-only, local machine only — used by scripts/neon-ops.ts for
# branch/snapshot management and to derive connection strings during
# migration work (#181). Project-scoped key; never set in Vercel or CI;
# revoke when migration work completes.
# NEON_API_KEY=neon_api_xxx

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.sabafpca.com

# Maintenance mode (server-side only — do NOT prefix with NEXT_PUBLIC_).
# Set to "true" in the Vercel Production environment to gate all public
# routes behind /under-construction. Leave unset/false in Preview,
# development, and CI so the full site stays reachable.
# SITE_MAINTENANCE_MODE=true

# NEXT_PUBLIC_USE_FIREBASE_EMULATOR is intentionally absent: it is set
# only by the Playwright E2E harness. Never set it in a real deployment —
# it connects the client SDK to emulators instead of production.
