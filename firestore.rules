rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in user whose email address is verified. Open email/password
    // sign-up means request.auth alone proves nothing, and an unverified
    // email claim must never be trusted for administrative authorization.
    function isVerifiedUser() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Canonical staff identity: a verified user whose email has a document
    // in the admins collection (managed via console/Admin SDK only).
    function isAdmin() {
      return isVerifiedUser()
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Shape check for public animal-registration submissions. Mirrors the
    // constraints in src/lib/animal-registration.ts — keep the two in
    // agreement. The allowlisted schema stops anonymous submitters from
    // injecting privileged or unexpected fields; string caps bound stored
    // data size; the initial status is forced to "pending" so a submitter
    // can never self-approve. Individual entries inside the animals list
    // cannot be iterated in rules — the client constrains them (required
    // inputs, enum radios, maxLength) and staff verify them on review.
    //
    // paymentReceipt must name the storage object bound to THIS document
    // ("receipts/<doc id>"): a submission can never point at an existing
    // receipt belonging to a different registration.
    function isValidRegistration(registrationId) {
      return request.resource.data.keys().hasOnly(
              ["ownerInfo", "animals", "paymentReceipt", "totalFee",
               "status", "createdAt", "updatedAt"])
          && request.resource.data.status == "pending"
          && request.resource.data.ownerInfo is map
          && request.resource.data.ownerInfo.keys().hasOnly(
              ["name", "address", "phone", "email"])
          && request.resource.data.ownerInfo.name is string
          && request.resource.data.ownerInfo.name.size() > 0
          && request.resource.data.ownerInfo.name.size() <= 120
          && request.resource.data.ownerInfo.address is string
          && request.resource.data.ownerInfo.address.size() > 0
          && request.resource.data.ownerInfo.address.size() <= 500
          && request.resource.data.ownerInfo.phone is string
          && request.resource.data.ownerInfo.phone.size() > 0
          && request.resource.data.ownerInfo.phone.size() <= 40
          && request.resource.data.ownerInfo.email is string
          && request.resource.data.ownerInfo.email.size() > 0
          && request.resource.data.ownerInfo.email.size() <= 320
          && request.resource.data.animals is list
          && request.resource.data.animals.size() > 0
          && request.resource.data.animals.size() <= 25
          && request.resource.data.totalFee is number
          && request.resource.data.totalFee >= 0
          && request.resource.data.totalFee <= 25000
          && (request.resource.data.paymentReceipt == null
              || request.resource.data.paymentReceipt
                  == "receipts/" + registrationId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    // Registration lifecycle (mirrors src/lib/animal-registration.ts):
    // pending -> approved | rejected, with admin corrections allowed
    // between any supported states. Unknown values are never writable.
    function isSupportedRegistrationStatus() {
      return request.resource.data.status
          in ["pending", "approved", "rejected"];
    }

    // Homepage content - public read, admin write
    match /homepage/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Canonical animal lifecycle (mirrors src/lib/animal-lifecycle.ts):
    // "available" is the only publicly visible status; "pending" and
    // "adopted" are retained but admin-only. The read check fails closed —
    // a missing or unrecognized status is never publicly readable.
    function isSupportedAnimalStatus() {
      return request.resource.data.status
          in ["available", "pending", "adopted"];
    }

    // Animals - public can read only animals listed as available;
    // pending/adopted animals and all writes are admin-only. Writes must
    // carry a supported status so a typo can never create an
    // unclassifiable record.
    match /animals/{animalId} {
      allow get, list: if resource.data.status == "available" || isAdmin();
      allow create, update: if isAdmin() && isSupportedAnimalStatus();
      allow delete: if isAdmin();
    }

    // FAQ - public read, admin write
    match /faq/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Veterinary Services - public read, admin write
    match /vetServices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Animal Adoptions page content - public read, admin write
    match /animalAdoptions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Animal Registration page content - public read, admin write.
    // The document holds only descriptive copy rendered on the public
    // registration page; fees are code constants, not CMS data.
    match /animalRegistration/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Animal Registrations - private owner data. The public form submits
    // unauthenticated, so create is open but shape-validated and forced to
    // "pending"; only admins can read or mutate submissions. Admin updates
    // must keep a supported lifecycle status so a typo can never create
    // an unclassifiable record.
    match /animalRegistrations/{registrationId} {
      allow create: if isValidRegistration(registrationId);
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && isSupportedRegistrationStatus();
    }

    // Admins collection - only admins can read/write
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
