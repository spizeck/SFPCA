rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in user whose email address is verified. Open email/password
    // sign-up means request.auth alone proves nothing, and an unverified
    // email claim must never be trusted for administrative authorization.
    function isVerifiedUser() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Canonical staff identity for rules-evaluated client writes: a
    // verified user carrying the admin custom claim. The claim is set by
    // the session route (/api/auth/session) after Postgres admin_users
    // authorizes the login — Postgres is the authority, the claim is its
    // rules-visible projection. The retired admins/ collection is never
    // consulted here.
    function isAdmin() {
      return isVerifiedUser()
          && request.auth.token.admin == true;
    }

    // Homepage content - public read, admin write
    match /homepage/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQ - public read, admin write
    match /faq/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Veterinary Services - public read, admin write
    match /vetServices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Animal Adoptions page content - public read, admin write
    match /animalAdoptions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Animal Registration page content - public read, admin write.
    // The document holds only descriptive copy rendered on the public
    // registration page; fees are code constants, not CMS data.
    match /animalRegistration/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Retired operational collections (#183) -------------------------
    // Postgres is the sole authority for animals, registration
    // submissions, and admin-user records. These collections no longer
    // participate in normal application behavior and fail closed for
    // every principal — including admins — so they can never serve as
    // an alternate write path or a stale read source. Pre-launch
    // documents left in place are inert and unreadable through the
    // client SDK; cleanup is an offline operation.

    match /animals/{animalId} {
      allow read, write: if false;
    }

    match /animalRegistrations/{registrationId} {
      allow read, write: if false;
    }

    match /admins/{email} {
      allow read, write: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
