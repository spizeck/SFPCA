rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Signed-in user whose email address is verified. Open email/password
    // sign-up means request.auth alone proves nothing.
    function isVerifiedUser() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Canonical staff identity: a verified user carrying the admin
    // custom claim set by the session route (Postgres admin_users is the
    // authority). No Firestore lookup — the admins/ collection is
    // retired and must never be an authorization input again.
    function isAdmin() {
      return isVerifiedUser()
          && request.auth.token.admin == true;
    }

    // Uploads are image assets only (site/team photos), max 5 MB.
    // request.resource is null on delete, so deletes only need isAdmin().
    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches("image/.*");
    }
    function canWrite() {
      return isAdmin()
          && (request.resource == null || isImageUpload());
    }

    // Payment-receipt uploads from the public registration form: image or
    // PDF, max 5 MB (mirrors isReceiptFile in src/lib/animal-registration.ts).
    function isReceiptUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.size > 0
          && (request.resource.contentType.matches("image/.*")
              || request.resource.contentType == "application/pdf");
    }

    // There is deliberately no images/ rule: no active workflow owns
    // the namespace (nothing in the app uploads to or reads from it,
    // and the production prefix is empty), so it falls through to
    // default-deny for everyone — same posture as animals/ below.
    // A future media feature must introduce explicit authorization
    // for its own prefix rather than reviving a generic catch-all.

    // Animal photos are plain URLs stored on the registry row —
    // nothing uploads to an animals/ Storage prefix, so there is
    // deliberately no animals/ rule: it falls through to default-deny.
    // A future upload feature must add lifecycle-aware authorization
    // (a photo for a pending/adopted/malformed animal must not become
    // publicly readable just because it landed under animals/).

    // Team photos - public read, admin-only image uploads
    match /team-photos/{allPaths=**} {
      allow read: if true;
      allow write: if canWrite();
    }

    // Payment receipts attached to registration submissions - private
    // data stored at receipts/<submission uuid>. The submission id is
    // generated client-side before upload so the object path is bound
    // to the Postgres registration_submissions row.
    //
    // The public form uploads unauthenticated, so create is open but
    // constrained to small image/PDF files; the resource == null check
    // keeps an anonymous uploader from overwriting an existing object
    // even where a PUT to an occupied path is classified as a create.
    //
    // There is no client-side read/update/delete at all — not even for
    // admins. Staff view receipts through short-lived signed URLs minted
    // by a server action, and orphan cleanup runs through the Admin SDK
    // in the scheduled sweep — both bypass rules entirely. A receipt
    // object is therefore unreachable via the client SDK for every
    // principal, and retired Firestore collections are never consulted
    // for authorization.
    match /receipts/{receiptId} {
      allow create: if resource == null && isReceiptUpload();
      allow read, update, delete: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
