{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "node ../scripts/firebase-cli.mjs emulators:start --only functions",
    "shell": "node ../scripts/firebase-cli.mjs functions:shell",
    "start": "npm run shell",
    "deploy": "node ../scripts/firebase-cli.mjs deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "axios": "^1.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^8.57.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
