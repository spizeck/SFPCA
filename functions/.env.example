# Vercel Configuration
# Get these from your Vercel dashboard
# 1. Go to Vercel -> Project Settings -> General
# 2. Find your Project ID (it shows the full ID like "prj_xxxxxxxxxxxx")
# 3. Go to Vercel -> Account Settings -> Tokens and create a token
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# Shared secret required to invoke the triggerRebuild HTTP endpoint.
# Generate a long random value (e.g. `openssl rand -hex 32`). When unset,
# triggerRebuild refuses all requests.
REBUILD_TRIGGER_TOKEN=your_random_secret_here
