{
  "name": "sfpca-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "tsx tests/e2e/db-server.ts",
    "prebuild": "tsx scripts/preview-migrate.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "migrate:firestore": "tsx scripts/migrate-firestore.ts",
    "test:db": "vitest run tests/db",
    "test": "npm run check:admin-import && vitest run",
    "test:watch": "vitest",
    "test:rules": "tsx scripts/emulators.ts exec --only auth,firestore,storage --project demo-sfpca \"node --test \\\"tests/*.test.mjs\\\"\"",
    "test:maintenance": "vitest run tests/maintenance.test.ts",
    "test:e2e": "tsx scripts/emulators.ts exec --only auth,firestore,storage --project demo-sfpca \"playwright test\"",
    "test:e2e:maintenance": "tsx scripts/emulators.ts exec --only auth,firestore,storage --project demo-sfpca \"playwright test --config playwright.maintenance.config.ts\"",
    "test:e2e:headed": "tsx scripts/emulators.ts exec --only auth,firestore,storage --project demo-sfpca \"playwright test --headed\"",
    "deploy:functions": "node scripts/deploy-functions.js",
    "check:admin-import": "node scripts/check-admin-import.mjs",
    "production-demo": "tsx scripts/production-demo.ts",
    "production-demo:check": "tsx scripts/production-demo.ts check",
    "production-demo:status": "tsx scripts/production-demo.ts status",
    "production-demo:verify": "tsx scripts/production-demo.ts verify",
    "prelaunch-cleanup": "tsx scripts/cleanup-prelaunch-legacy-seed.ts",
    "prelaunch-cleanup:audit": "tsx scripts/cleanup-prelaunch-legacy-seed.ts audit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/nextjs": "11.1.0",
    "@vercel/functions": "3.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.0",
    "klaro": "^0.7.21",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "firebase-tools": "^15.30.2",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4",
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@sentry/opentelemetry": {
      "@opentelemetry/core": "^2.8.0"
    },
    "@sentry/node-core": {
      "@opentelemetry/core": "^2.8.0"
    }
  }
}
